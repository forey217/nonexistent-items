	"dialogue_history": [
		{
			"phase": -1,
			"segment": "opening",
			"speaker": "tesla",
			"style": "story",
			"text": "衍月？欢迎来到世界检查局。我是特斯拉，今天由我带你熟悉工作。",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "opening",
			"speaker": "yanyue",
			"style": "story",
			"text": "我来的时候，看见外面的楼梯通向了两片不同的天空。",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "opening",
			"speaker": "tesla",
			"style": "story",
			"text": "看来你已经见过我们要处理的问题了。",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "opening",
			"speaker": "yanyue",
			"style": "story",
			"text": "那不是这里的建筑风格？",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "opening",
			"speaker": "tesla",
			"style": "story",
			"text": "至少不在设计图上。",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "opening",
			"speaker": "tesla",
			"style": "story",
			"text": "平行世界通常各走各的路。但有些时候，它们会靠得太近，甚至重叠在一起。",
			"visual": "overlap"
		},
		{
			"phase": -1,
			"segment": "opening",
			"speaker": "tesla",
			"style": "story",
			"text": "同一个地方，会同时出现几套不同的规则。物品受哪一套影响，也就变得不稳定。",
			"visual": "overlap"
		},
		{
			"phase": -1,
			"segment": "opening",
			"speaker": "yanyue",
			"style": "story",
			"text": "所以，我们要把它们分开？",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "opening",
			"speaker": "tesla",
			"style": "story",
			"text": "先锚定，让每个世界找回自己的位置。我们用这个——镇纸。",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "opening",
			"speaker": "yanyue",
			"style": "story",
			"text": "压住纸的那个镇纸？",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "exhibit-skip",
			"speaker": "tesla",
			"style": "story",
			"text": "先锚定，让每个世界找回自己的位置。我们用这个——镇纸。",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "after-skip",
			"speaker": "tesla",
			"style": "subtitle",
			"text": "准备好了，就到星系仪旁边来。",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "reminder",
			"speaker": "tesla",
			"style": "story",
			"text": "先到星系仪旁边，找出那片区域。",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "after-skip",
			"speaker": "tesla",
			"style": "subtitle",
			"text": "准备好了，就到星系仪旁边来。",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "select-whole",
			"speaker": "yanyue",
			"style": "subtitle",
			"text": "要去的地方，就在这块水晶里面？",
			"visual": ""
		},
		{
			"phase": -1,
			"segment": "select-fragments",
			"speaker": "tesla",
			"style": "subtitle",
			"text": "找到了。01号，新手校准室。",
			"visual": ""
		},
		{
			"phase": 0,
			"segment": "stage-0",
			"speaker": "tesla",
			"style": "subtitle",
			"text": "通讯正常。听得见吗？",
			"visual": ""
		},
		{
			"phase": 0,
			"segment": "stage-0",
			"speaker": "yanyue",
			"style": "subtitle",
			"text": "听得见。这里看起来……比外面安静。",
			"visual": ""
		},
		{
			"phase": 0,
			"segment": "stage-0",
			"speaker": "tesla",
			"style": "subtitle",
			"text": "重叠不一定会发出声音。看导轨上的镇纸，还有那三处黄铜机关。",
			"visual": ""
		},
		{
			"phase": 0,
			"segment": "stage-0",
			"speaker": "tesla",
			"style": "subtitle",
			"text": "先定星位，再压月痕，最后封界缝。这一片区域就能稳定下来。",
			"visual": "anchors"
		},
		{
			"phase": 0,
			"segment": "test-ice-lesson",
			"speaker": "tesla",
			"style": "light",
			"text": "现在是冰晶世界。导轨的摩擦很小，镇纸受到推动后，会一直滑到挡块前。",
			"visual": "law-ice"
		},
		{
			"phase": 0,
			"segment": "hint",
			"speaker": "tesla",
			"style": "light",
			"text": "星位在带五角星的锚座上。",
			"visual": ""
		},
		{
			"phase": 0,
			"segment": "first-push",
			"speaker": "yanyue",
			"style": "subtitle",
			"text": "真的只推了一下……它自己滑过去了。",
			"visual": "law-ice"
		},
		{
			"phase": 1,
			"segment": "stage-1",
			"speaker": "yanyue",
			"style": "light",
			"text": "到地方了。星位怎么没亮？",
			"visual": ""
		},
		{
			"phase": 1,
			"segment": "stage-1",
			"speaker": "tesla",
			"style": "light",
			"text": "位置对了，重量还不够。",
			"visual": ""
		},
		{
			"phase": 1,
			"segment": "stage-1",
			"speaker": "tesla",
			"style": "light",
			"text": "切到重力世界。同一块镇纸在那里会变得更重，足以压下踏板。",
			"visual": "law-heavy"
		},
		{
			"phase": 2,
			"segment": "stage-2",
			"speaker": "yanyue",
			"style": "aside",
			"text": "星位亮了，挡块也打开了。",
			"visual": "law-heavy"
		},
		{
			"phase": 2,
			"segment": "stage-2",
			"speaker": "tesla",
			"style": "subtitle",
			"text": "第一处坐标已经锁定。接下来找月痕，就在导轨尽头的上方。",
			"visual": ""
		},
		{
			"phase": 3,
			"segment": "stage-3",
			"speaker": "yanyue",
			"style": "light",
			"text": "下面到了。可月痕在那么高的地方。",
			"visual": ""
		},
		{
			"phase": 3,
			"segment": "stage-3",
			"speaker": "tesla",
			"style": "light",
			"text": "还记得第三个世界吗？倒悬世界的重力朝上。",
			"visual": "law-inverted"
		},
		{
			"phase": 3,
			"segment": "first-float",
			"speaker": "yanyue",
			"style": "subtitle",
			"text": "纸片也飘起来了……我怎么还站在地上？",
			"visual": "law-inverted"
		},
		{
			"phase": 4,
			"segment": "stage-4",
			"speaker": "yanyue",
			"style": "subtitle",
			"text": "月痕也亮了。可那道裂缝还在。",
			"visual": ""
		},
		{
			"phase": 5,
			"segment": "stage-5",
			"speaker": "yanyue",
			"style": "subtitle",
			"text": "裂缝合上了。",
			"visual": ""
		},
		{
			"phase": 5,
			"segment": "stage-5",
			"speaker": "tesla",
			"style": "aside",
			"text": "读数稳定，三处校准全部完成。做得不错。",
			"visual": ""
		},
		{
			"phase": 4,
			"segment": "gate-lost",
			"speaker": "yanyue",
			"style": "subtitle",
			"text": "门又关了。",
			"visual": ""
		},
		{
			"phase": 5,
			"segment": "gate-restored",
			"speaker": "tesla",
			"style": "subtitle",
			"text": "归位门已经稳定。保持重力世界，通过归位门回来。",
			"visual": ""
		},
		{
			"phase": 5,
			"segment": "archive",
			"speaker": "tesla",
			"style": "subtitle",
			"text": "现场校准完成。开始归档。",
			"visual": ""
		},
